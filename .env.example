# Banking and Account Management System - Environment Variables Template
# Copy this file to .env and adjust the values as needed

# Server Port
PORT=3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=banking_management_system

# Express Session Secret (use a long, random string in production)
SESSION_SECRET=super_secret_session_key_change_in_production_123456

# Environment (development or production)
NODE_ENV=development
